# franken-stream environment variables (all optional)

# Rust server listen address (default: 0.0.0.0:3001)
# BIND_ADDR=0.0.0.0:3001

# Python sidecar module for Rust server (default: franken_stream.sidecar_main)
# SIDECAR_MODULE=franken_stream.sidecar_main

# LLM endpoint for CSS selector healing (enables auto-repair of broken scrapers)
# FRANKEN_STREAM_LLM_ENDPOINT=http://localhost:11434/api/generate

# HTTP/HTTPS proxy (useful if streaming sites are geo-blocked)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
